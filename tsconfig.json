{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "typeRoots": ["./node_modules/@types", "./types"],
    "strict": true,
    "noImplicitAny": true,
    "outDir": "dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "./*.js",
    "src/**/*.ts",
    "test/**/*.ts",
    "types/express.d.ts"
  ]
}
